From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Merloch <47682274+Merloch@users.noreply.github.com>
Date: Fri, 4 Sep 2026 16:00:00 -0300
Subject: [PATCH] Cache unsupported vendor keys

SemCaptureResult.a() reads vendor keys off every capture result and
relies on catching the exception thrown when the HAL does not expose
the tag, with no memory of the failure. On r8q three keys the donor
camera app always reads (textDetectionInfo, nightModeSuggestion,
nightIconState) are missing, so it throws and logs 90 times a second
during preview. Remember the keys that failed and return null for
them straight away.
---
diff --git a/smali_classes3/com/samsung/android/camera/core2/local/vendorkey/SemCaptureResult.smali b/smali_classes3/com/samsung/android/camera/core2/local/vendorkey/SemCaptureResult.smali
index 7deb901..7f6fb99 100644
--- a/smali_classes3/com/samsung/android/camera/core2/local/vendorkey/SemCaptureResult.smali
+++ b/smali_classes3/com/samsung/android/camera/core2/local/vendorkey/SemCaptureResult.smali
@@ -310,6 +310,8 @@
 
 .field public static final z1:Landroid/hardware/camera2/CaptureResult$Key;
 
+.field public static final unicaMissingKeys:Ljava/util/Set;
+
 
 # direct methods
 .method static constructor <clinit>()V
@@ -2059,6 +2061,12 @@
 
     invoke-direct {v0, v1, v3}, Landroid/hardware/camera2/CaptureResult$Key;-><init>(Ljava/lang/String;Ljava/lang/Class;)V
 
+    invoke-static {}, Ljava/util/concurrent/ConcurrentHashMap;->newKeySet()Ljava/util/concurrent/ConcurrentHashMap$KeySetView;
+
+    move-result-object v0
+
+    sput-object v0, Lcom/samsung/android/camera/core2/local/vendorkey/SemCaptureResult;->unicaMissingKeys:Ljava/util/Set;
+
     return-void
 .end method
 
@@ -2087,6 +2095,17 @@
     return-object v0
 
     :cond_1
+    sget-object v2, Lcom/samsung/android/camera/core2/local/vendorkey/SemCaptureResult;->unicaMissingKeys:Ljava/util/Set;
+
+    invoke-interface {v2, p1}, Ljava/util/Set;->contains(Ljava/lang/Object;)Z
+
+    move-result v3
+
+    if-eqz v3, :cond_unica_known
+
+    return-object v0
+
+    :cond_unica_known
     :try_start_0
     invoke-virtual {p0, p1}, Landroid/hardware/camera2/CaptureResult;->get(Landroid/hardware/camera2/CaptureResult$Key;)Ljava/lang/Object;
 
@@ -2099,6 +2118,10 @@
     :catch_0
     move-exception p0
 
+    sget-object v2, Lcom/samsung/android/camera/core2/local/vendorkey/SemCaptureResult;->unicaMissingKeys:Ljava/util/Set;
+
+    invoke-interface {v2, p1}, Ljava/util/Set;->add(Ljava/lang/Object;)Z
+
     new-instance v2, Ljava/lang/StringBuilder;
 
     const-string v3, "UnsupportedOperationException - "
