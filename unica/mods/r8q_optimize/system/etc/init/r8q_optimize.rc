# r8q tunables restored to the stock (Android 13) values that the donor
# system does not carry. Applied once boot has completed so nothing later in
# the boot sequence overwrites them.
#
# Not restored: the 512 kB read_ahead_kb stock init.qcom.rc writes on the
# dynamic partitions. On this kernel the value is clamped straight back to
# 128 kB (verified live: writing 512 to /sys/block/dm-0/queue/read_ahead_kb or
# to its bdi reads back 128 immediately), so the write would be a no-op.
on property:sys.boot_completed=1
    # Stock r8q init.rc caps midground apps at 30% CPU capacity; the S22
    # donor init.rc caps them at 20%.
    write /dev/cpuctl/midground/cpu.uclamp.max 30
